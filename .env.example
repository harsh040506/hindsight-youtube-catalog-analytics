# Any long random string; encrypts the session cookies.  Generate with:  openssl rand -base64 32
SESSION_SECRET=

# Optional. When rotating SESSION_SECRET, put the old value here for a while so nobody is signed out.
# SESSION_SECRET_PREVIOUS=

# Optional. Only set if you serve the app from a custom domain and want to pin the OAuth redirect host.
# APP_URL=https://hindsight.example.com

# Optional. A shared store makes rate limits and outage protection agree across serverless instances.
# Upstash Redis (or Vercel KV, which sets KV_REST_API_URL / KV_REST_API_TOKEN for you). Holds only short-lived
# counters and flags under hashed keys; never channel data or tokens.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
